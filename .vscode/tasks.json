{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python：运行当前文件",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
